---
/**
 * index.astro — landing page hero.
 *
 * Demonstrates the brand vocabulary the foundations preset exposes:
 *   - colors:  bg-sand / text-ink / text-teal / bg-coral / text-sky
 *   - type:    font-display (Space Grotesk) / font-mono (JetBrains Mono)
 *   - motion:  animate-fade-up (from the preset) — or the .anim-* classes
 *   - layout:  max-w-prose / px-gutter / py-section (token-driven spacing)
 *
 * Everything renders statically. To add interactivity, drop a React island
 * (see the commented example below + the README).
 */
import Base from "../layouts/Base.astro";

// Example of importing a React island. Uncomment to render it interactively.
// import Counter from "../components/Counter.tsx";
---

<Base
  title="saltycodestudio — Clean code, warm coast."
  description="A web & dev studio. Premium frontends, shipped clean."
>
  <main class="mx-auto max-w-prose px-gutter">
    <section class="flex min-h-dvh flex-col justify-center py-section">
      <!-- Eyebrow / tagline in mono, letterspaced -->
      <p class="animate-fade-up font-mono text-sm uppercase tracking-widest text-coral">
        saltycodestudio
      </p>

      <!-- Display headline -->
      <h1
        class="animate-fade-up mt-4 font-display text-5xl font-bold leading-tight text-teal sm:text-6xl"
        style="animation-delay: 80ms"
      >
        Clean code,
        <span class="text-coral">warm coast.</span>
      </h1>

      <!-- Supporting copy -->
      <p
        class="animate-fade-up mt-6 max-w-md text-lg text-ink/80"
        style="animation-delay: 160ms"
      >
        A small studio building fast, premium websites and tools. This page is a
        live Astro + Tailwind starter wired to the <code class="font-mono text-sky">saltycodestudio-parts</code>
        foundations.
      </p>

      <!-- CTA row -->
      <div
        class="animate-fade-up mt-10 flex flex-wrap items-center gap-4"
        style="animation-delay: 240ms"
      >
        <a
          href="mailto:hello@saltycodestudio.com"
          class="rounded-lg bg-coral px-6 py-3 font-display font-semibold text-white shadow-coral transition-transform hover:-translate-y-0.5"
        >
          Start a project
        </a>
        <a
          href="https://saltycodestudio.com"
          class="rounded-lg border border-teal/30 px-6 py-3 font-display font-semibold text-teal transition-colors hover:bg-teal/5"
        >
          See the work
        </a>
      </div>

      <!--
        REACT ISLAND EXAMPLE
        --------------------
        1. uncomment the import at the top of this file
        2. uncomment the line below
        3. `client:visible` hydrates it once it scrolls into view. Other
           directives: client:load (immediately), client:idle, client:media.
        See the README for pulling .tsx parts from ../../components/react.
      -->
      <!-- <Counter client:visible /> -->
    </section>
  </main>
</Base>
